<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚙️ Настройки MQTT брокера"
        android:textColor="@color/text_main"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Параметры подключения к WQTT или локальному серверу"
        android:textColor="@color/text_muted"
        android:textSize="13sp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textColorHint="@color/text_muted"
        app:boxStrokeColor="@color/accent_blue">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etBrokerHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Адрес брокера (напр. wqtt.ru)"
            android:inputType="textUri"
            android:textColor="@color/text_main" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColorHint="@color/text_muted"
        app:boxStrokeColor="@color/accent_blue">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etBrokerPort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Порт (обычно 1883)"
            android:inputType="number"
            android:textColor="@color/text_main" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColorHint="@color/text_muted"
        app:boxStrokeColor="@color/accent_blue">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etMqttUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Имя пользователя (Логин WQTT)"
            android:inputType="text"
            android:textColor="@color/text_main" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColorHint="@color/text_muted"
        app:boxStrokeColor="@color/accent_blue"
        app:passwordToggleEnabled="true"
        app:passwordToggleTint="@color/text_muted">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etMqttPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Пароль WQTT"
            android:inputType="textPassword"
            android:textColor="@color/text_main" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColorHint="@color/text_muted"
        app:boxStrokeColor="@color/accent_blue">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etTopicPrefix"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Префикс топиков (по умолчанию warmfloor)"
            android:inputType="text"
            android:textColor="@color/text_main" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveSettings"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:text="СОХРАНИТЬ И ПОДКЛЮЧИТЬСЯ"
        android:textColor="@color/bg_main"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="@color/accent_blue"
        app:cornerRadius="12dp" />

</LinearLayout>
